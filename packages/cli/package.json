{
  "name": "termbridge",
  "version": "0.3.13",
  "type": "module",
  "description": "Local-first terminal beaming with tmux + Cloudflare tunnel and a mobile-friendly UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inline0/termbridge.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/inline0/termbridge/issues"
  },
  "homepage": "https://github.com/inline0/termbridge#readme",
  "keywords": [
    "terminal",
    "tmux",
    "tunnel",
    "cloudflare",
    "cli",
    "mobile",
    "xterm"
  ],
  "bin": {
    "termbridge": "dist/bin.js"
  },
  "scripts": {
    "build": "pnpm ui:build && tsup",
    "dev": "node ../../scripts/clear-dev-cache.mjs && pnpm ui:dev",
    "start": "node dist/bin.js",
    "typecheck": "tsc-rs --noEmit -p tsconfig.json",
    "ui:dev": "vite --config vite.config.ts",
    "ui:build": "vite build --config vite.config.ts",
    "prepack": "pnpm build"
  },
  "files": [
    "dist",
    "ui/dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@daytonaio/sdk": "catalog:",
    "dotenv": "catalog:",
    "ink": "catalog:",
    "node-pty": "catalog:",
    "qrcode-terminal": "catalog:",
    "ws": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@silk-hq/components": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@termbridge/shared": "workspace:*",
    "@termbridge/terminal": "workspace:*",
    "@termbridge/tunnel": "workspace:*",
    "@termbridge/ui": "workspace:*",
    "@xterm/addon-fit": "catalog:",
    "@xterm/addon-web-links": "catalog:",
    "@xterm/addon-webgl": "catalog:",
    "@xterm/xterm": "catalog:",
    "@types/qrcode-terminal": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "lucide-react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "catalog:",
    "vite": "catalog:",
    "@termbridge/tsconfig": "workspace:*"
  }
}
