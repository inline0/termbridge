{
  "name": "@termbridge/workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm exec playwright install chromium",
    "dev": "pnpm --filter termbridge dev",
    "dev:beam": "node scripts/dev-beam.mjs",
    "dev:beam:multi": "TERMBRIDGE_SESSIONS=2 pnpm dev:beam",
    "dev:beam:proxy": "TERMBRIDGE_PROXY_PORT=5173 pnpm dev:beam",
    "build": "pnpm -r build",
    "beam:codex": "pnpm build && node packages/cli/dist/bin.js --session codex",
    "sandbox:daytona:debug": "node scripts/daytona-debug.mjs",
    "sandbox:daytona:debug:direct": "node scripts/daytona-debug.mjs --direct",
    "sandbox:daytona:debug:claude": "node scripts/daytona-debug.mjs --agent claude",
    "sandbox:daytona:debug:codex": "node scripts/daytona-debug.mjs --agent codex",
    "sandbox:daytona:debug:opencode": "node scripts/daytona-debug.mjs --agent opencode",
    "sandbox:cleanup": "node scripts/sandbox-cleanup.mjs",
    "test:direct": "pnpm build && node scripts/test-direct.mjs",
    "test": "pnpm test:tooling && pnpm test:mocked",
    "test:mocked": "vitest run --coverage --config vitest.config.ts",
    "test:cli": "vitest run --config vitest.cli.config.ts",
    "test:cli:published": "TERMBRIDGE_TEST_PUBLISHED=1 vitest run --config vitest.cli.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:startup": "vitest run --config vitest.cli.config.ts packages/cli/integration/startup.test.ts",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --max-warnings=0 && pnpm audit:workspace && pnpm audit:docs",
    "lint:fix": "oxlint . --fix --max-warnings=0 && pnpm audit:workspace && pnpm audit:docs",
    "typecheck": "tsc-rs --noEmit -p tsconfig.json && pnpm -r typecheck",
    "docs:check": "pnpm audit:docs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify": "pnpm check && pnpm test:cli && pnpm test:package",
    "test:tooling": "node --test scripts/*.test.ts scripts/oxlint-plugins/*.test.ts",
    "test:package": "node scripts/check-package.mjs",
    "audit:workspace": "node scripts/check-workspace.ts",
    "audit:docs": "node scripts/check-docs-content.mjs --root docs --expected-docs 16 --expected-nav 3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@termbridge/tsconfig": "workspace:*",
    "@oxlint/plugins": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsc-rs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@daytonaio/sdk": "catalog:",
    "dotenv": "catalog:",
    "@silk-hq/components": "catalog:",
    "@xterm/xterm": "catalog:",
    "@xterm/addon-fit": "catalog:"
  },
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.0",
    "pnpm": ">=12.14.0"
  }
}
